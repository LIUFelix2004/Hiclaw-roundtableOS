# Hermes AgentOS server configuration
PORT=8648

# Set to 1 to force built-in demo data (no model API required).
# If OPENAI_API_KEY is missing, mock mode is enabled automatically.
MOCK_LLM=1

# Optional: real model gateway (e.g. NewAPI / OpenAI-compatible endpoint)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.example.com/v1

# Multi-provider routing: auto selects the first configured provider
# (Anthropic > DeepSeek > OpenAI). Set LLM_PROVIDER to force one provider,
# or use a model prefix such as anthropic:claude-opus-5.
#
# Mock mode turns off as soon as ANY of these keys is set — configuring only
# ANTHROPIC_API_KEY is enough. Confirm with: curl localhost:8648/health
# and check that "mock" is false and "provider" names the one you expect.
# LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional per-role model overrides
# MODEL_DATA=gpt-4o-mini
# MODEL_RESEARCH=gpt-4o-mini
# MODEL_ANALYST=gpt-4o
# MODEL_WRITER=gpt-4o
# MODEL_MODERATOR=gpt-4o
# MODEL_VALIDATOR=gpt-4o-mini
# MODEL_ROLLBACK=gpt-4o-mini
# MODEL_PLANNER=gpt-4o-mini

# Set to 0 to disable the LLM-driven Planner and always use the rule fallback.
# PLANNER_LLM=0

# Experience Memory JSON store (default: packages/server/data/experience.json)
# HERMES_DATA_DIR=./data
# HERMES_EXPERIENCE_FILE=./data/experience.json

# ─────────────────────────────────────────────────────────────────────
# hiclaw 后端 + hermes-studio 前端（比赛形态）
# ─────────────────────────────────────────────────────────────────────
# hiclaw-bridge 端口，避开 legacy server(8648) 与 studio 前端(8649)
# HICLAW_BRIDGE_PORT=8650

# studio BFF 把竞赛链路转发到哪个后端。指向 8650 即切换到 hiclaw 编排；
# 不设则回落到 legacy server(8648)。
# HERMES_COMPETITION_MODE=1
# HERMES_COMPETITION_BACKEND_URL=http://127.0.0.1:8650

# Matrix 接入信息。四项配齐 bridge 才进 live 模式，缺任一项自动回落 mock
# （mock 下由 mock-player 回放，演示不依赖网络）。
# HICLAW_MATRIX_BASE_URL=https://matrix.example.org
# HICLAW_MATRIX_ROOM_ID=!room:example.org
# HICLAW_MATRIX_TOKEN=syt_xxx            # 或用 USER + PASSWORD 密码登录
# HICLAW_MATRIX_USER_ID=@orchestrator:example.org
# HICLAW_MATRIX_USER=orchestrator
# HICLAW_MATRIX_PASSWORD=

# Worker 派发：多角色映射（JSON）或单 Worker 直派，二选一
# HICLAW_WORKERS={"data":"@w-data:example.org","research":"@w-research:example.org"}
# HICLAW_WORKER_USER_ID=@worker:example.org

# hiclaw 模型网关
# HICLAW_GATEWAY_BASE_URL=
# HICLAW_GATEWAY_KEY=
# HICLAW_PLANNER_MODEL=deepseek-v4-pro
