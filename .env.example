# Hermes AgentOS server configuration
PORT=8648

# Set to 1 to force built-in demo data (no model API required).
# If OPENAI_API_KEY is missing, mock mode is enabled automatically.
MOCK_LLM=1

# Optional: real model gateway (e.g. NewAPI / OpenAI-compatible endpoint)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.example.com/v1

# Multi-provider routing: auto selects the first configured provider
# (Anthropic > DeepSeek > OpenAI). Set LLM_PROVIDER to force one provider,
# or use a model prefix such as anthropic:claude-opus-5.
#
# Mock mode turns off as soon as ANY of these keys is set — configuring only
# ANTHROPIC_API_KEY is enough. Confirm with: curl localhost:8648/health
# and check that "mock" is false and "provider" names the one you expect.
# LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional per-role model overrides
# MODEL_DATA=gpt-4o-mini
# MODEL_RESEARCH=gpt-4o-mini
# MODEL_ANALYST=gpt-4o
# MODEL_WRITER=gpt-4o
# MODEL_MODERATOR=gpt-4o
# MODEL_VALIDATOR=gpt-4o-mini
# MODEL_ROLLBACK=gpt-4o-mini
# MODEL_PLANNER=gpt-4o-mini

# Set to 0 to disable the LLM-driven Planner and always use the rule fallback.
# PLANNER_LLM=0

# Experience Memory JSON store (default: packages/server/data/experience.json)
# HERMES_DATA_DIR=./data
# HERMES_EXPERIENCE_FILE=./data/experience.json
